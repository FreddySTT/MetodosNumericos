# Genere una clave larga localmente, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=cambie-esto-por-una-clave-aleatoria-larga

# Seleccione mysql, sqlserver o firebase
DATA_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sistema_fatiga
MYSQL_USER=root
MYSQL_PASSWORD=

# SQL Server (se usa cuando DATA_BACKEND=sqlserver)
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=sistema_fatiga
SQLSERVER_TRUSTED=1
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_CERT=yes

# ID del proyecto Firebase (Firebase Console > Configuración del proyecto)
FIREBASE_PROJECT_ID=su-proyecto-firebase
FIRESTORE_DATABASE_ID=(default)

# Ruta local al JSON de cuenta de servicio. Nunca suba ese archivo al repositorio.
# Windows: C:\\Users\\SU_USUARIO\\.firebase\\serviceAccount.json
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/SU_USUARIO/.firebase/serviceAccount.json

# Use 1 solamente detrás de HTTPS en producción. En local deje 0.
COOKIE_SECURE=0
